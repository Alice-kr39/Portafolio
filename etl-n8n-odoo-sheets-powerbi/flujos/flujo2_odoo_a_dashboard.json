    {
      "parameters": {
        "jsCode": "const pedidos = $input.all();\n\nconst totalPedidos = pedidos.length;\n\nconst totalVentas = pedidos.reduce((sum, p) => {\n  return sum + (p.json.amount_total || 0);\n}, 0);\n\nconst ticketPromedio = totalPedidos > 0 \n  ? (totalVentas / totalPedidos).toFixed(2) \n  : 0;\n\n// En vez de usar \"hoy\", usamos la fecha del pedido más reciente en Odoo\n// date_order es el campo de fecha que Odoo asigna a cada pedido de venta\nconst fechasPedidos = pedidos\n  .map(p => p.json.date_order)\n  .filter(f => f) // quita nulos\n  .sort()\n  .reverse();\n\nconst fechaActualizacion = fechasPedidos.length > 0\n  ? fechasPedidos[0].split(' ')[0]  // toma solo la parte de fecha, sin hora\n  : new Date().toISOString().split('T')[0]; // respaldo si no hay pedidos\n\nreturn [{\n  json: {\n    fecha_actualizacion: fechaActualizacion,\n    total_pedidos: totalPedidos,\n    total_ventas_mxn: totalVentas.toFixed(2),\n    ticket_promedio: ticketPromedio\n  }\n}];"
      },
